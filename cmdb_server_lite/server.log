            AND mhc.bk_set_id = m.bk_set_id
            AND mhc.bk_biz_id = m.bk_biz_id
        
        WHERE mhc.bk_host_id = ?
          AND mhc.bk_supplier_account = ?
          AND biz.bk_supplier_account = ?
          AND s.bk_supplier_account = ?
          AND m.bk_supplier_account = ?
    
        ORDER BY biz.bk_biz_id, s.bk_set_id, m.bk_module_id
    
