            s.bk_set_name,
            m.bk_module_id,
            m.bk_module_name
        FROM cc_ModuleHostConfig mhc
        INNER JOIN cc_ApplicationBase biz
            ON mhc.bk_biz_id = biz.bk_biz_id
        INNER JOIN cc_SetBase s
